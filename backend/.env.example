# Copiar a backend/.env. Los valores de abajo son los de desarrollo: con ellos la API
# arranca y responde con el contenido real de content/ sin ninguna infraestructura.

# development | staging | production
ENVIRONMENT=development

# --- Adaptadores -------------------------------------------------------------
# json     -> lee content/catalog.seed.json y escribe en CATALOG_WRITE_PATH
# supabase -> Postgres via PostgREST (obligatorio en produccion)
PERSISTENCE_BACKEND=json

# dev      -> require_admin acepta DEV_ADMIN_TOKEN. Settings.validate() aborta el
#             arranque si se combina con ENVIRONMENT=production.
# supabase -> verificacion real del JWT (firma via JWKS o HS256, aud, exp)
AUTH_BACKEND=dev
DEV_ADMIN_TOKEN=cambia-esto-en-tu-maquina

# --- Adaptador JSON ----------------------------------------------------------
# Por defecto ../content/catalog.seed.json y ../content/media-manifest.json.
# CATALOG_SEED_PATH=
# MEDIA_MANIFEST_PATH=
# CATALOG_WRITE_PATH=

# --- Media -------------------------------------------------------------------
# Base publica. Debe valer lo mismo con json y con supabase, o cambiar de adaptador
# moveria las URLs del frontend. Si se omite, cae a SUPABASE_URL.
MEDIA_PUBLIC_BASE_URL=https://xxxxxxxxxxxx.supabase.co

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# Solo el backend la conoce. Nunca sale al navegador.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# --- Auth Supabase -----------------------------------------------------------
# Proyectos con firma asimetrica: la clave se resuelve por JWKS, no hace falta secreto.
# Proyectos legacy HS256: define el secreto y se verifica con el.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
# Lista blanca de uuid de admin, separados por coma. Vacia = cualquier usuario
# autenticado. La autorizacion de fila la impone Postgres con is_admin() (addendum A1).
ADMIN_USER_IDS=

# --- Web ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- Revalidacion ISR del front ----------------------------------------------
FRONTEND_REVALIDATE_URL=
FRONTEND_REVALIDATE_SECRET=
