# Cuando no está definida, el front cae al seed de `content/catalog.seed.json`
# y arranca sin backend. Con ella apuntando a FastAPI, consume /api/v1.
NEXT_PUBLIC_API_URL=
# Segundos de ISR para las rutas públicas.
NEXT_PUBLIC_REVALIDATE=300

# --- Panel de administración (/admin) ----------------------------------------
# El panel llama a /api/v1/admin/* desde el servidor de Next. Si no se define,
# cae a NEXT_PUBLIC_API_URL. Nunca se expone al navegador.
ADMIN_API_URL=http://127.0.0.1:8000

# Supabase Auth: magic link. Son las claves públicas (anon), las únicas que
# pueden salir al navegador. La `service_role` no aparece aquí ni debe hacerlo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Escape de desarrollo, espejo de AUTH_BACKEND=dev del backend. Solo se activa
# si Supabase NO está configurado y NODE_ENV != production. Debe valer lo mismo
# que DEV_ADMIN_TOKEN en backend/.env.
ADMIN_DEV_TOKEN=

# Secreto compartido con FRONTEND_REVALIDATE_SECRET del backend, para que el
# endpoint de revalidación del front solo acepte llamadas del backend.
REVALIDATE_SECRET=
